# Required: Vertex AI project + region for the AnthropicVertex client (also used by the Cloud Trace
# exporter). The demos raise if these are unset. Auth is GCP ADC -- there is NO Anthropic API key.
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-project-id
# region for AnthropicVertex: "global" (recommended), a multi-region ("us"/"eu"), or a specific region.
GOOGLE_CLOUD_LOCATION=global

# Optional: attribute usage to an app-level end user via Anthropic's metadata.user_id (lands in
# Anthropic-side telemetry). Use a HASHED value for anything PII; it is sanitized to lowercase
# [a-z0-9_-], <= 63 chars. Leave unset to auto-resolve the running IAM principal.
# ANTHROPIC_USER_ID=user_ab12cd
