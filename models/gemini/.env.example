# Required: Vertex AI project + location (used for ADC auth, request/response logging,
# and the Cloud Trace exporter). The demos raise if these are unset.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Required to enable Vertex request/response logging to BigQuery (project.dataset.table).
BIGQUERY_LOGGING_DESTINATION=your-project-id.your-dataset-name.your-table-name

# Optional: attribute token usage to an app-level end user instead of the IAM service account.
# Lands in full_request.labels.caller. Use a HASHED value for anything PII (Google disallows
# personal info in labels); must be lowercase [a-z0-9_-], <= 63 chars.
# TOKEN_USAGE_LABEL=user_ab12cd

# Optional: Vertex AI API key (global endpoint) as an alternative to ADC auth.
# GOOGLE_CLOUD_API_KEY=your-api-key
